source "https://rubygems.org"

gem "jekyll", "~> 4.4.1"
gem "jekyll-feed"
gem "jekyll-sitemap"
gem "jekyll-paginate"

# Windows and JRuby platform support
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.1", :platforms => [:mingw, :x64_mingw, :mswin]
gem "http_parser.rb", "~> 0.8.0", :platforms => [:jruby]
